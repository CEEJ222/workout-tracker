# Copy to .env.local and fill in your Supabase project credentials.
# See .env.local for where to find each value in the Supabase dashboard.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Used by the Phase 3 seed script to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — server-only, used by scripts/capture-migrations.sh
# to pull applied migration SQL back into supabase/migrations/.
#   Dashboard → Connect (top bar) → Session pooler → URI
# Leave blank if you don't need to capture migrations.
SUPABASE_DB_URL=
